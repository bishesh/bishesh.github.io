<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>{% if title and title != site.name %}{{ title }} · {% endif %}{{ site.name }}</title>
<meta name="description" content="{{ description or site.description }}">
<meta property="og:title" content="{{ title or site.name }}">
<meta property="og:description" content="{{ description or site.description }}">
<meta property="og:type" content="website">
<meta name="theme-color" content="#FAF8F4" media="(prefers-color-scheme: light)">
<meta name="theme-color" content="#12151B" media="(prefers-color-scheme: dark)">
<link rel="icon" href="/assets/img/favicon.svg" type="image/svg+xml">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600&family=Source+Serif+4:ital,opsz,wght@0,8..60,400;0,8..60,600;0,8..60,700;1,8..60,400&display=swap" rel="stylesheet">
<link rel="stylesheet" href="/assets/css/site.css">
<script>try{var t=localStorage.getItem("theme");if(t)document.documentElement.dataset.theme=t}catch(e){}</script>
</head>
<body{% if persona %} data-persona="{{ persona }}"{% endif %}>
<header class="site-header">
  <div class="container">
    <a class="brand" href="/">{{ site.name }}<span>{{ site.native_name }}</span></a>
    <nav class="nav" id="nav" aria-label="Main">
      {%- for item in site.nav %}
      <a href="{{ item.url }}"{% if page.url == item.url %} aria-current="page"{% endif %} data-persona="{{ item.persona }}">{% if item.persona %}<i class="dot {{ item.persona }}"></i>{% endif %}{{ item.label }}</a>
      {%- endfor %}
      <button class="theme-toggle" type="button" aria-label="Toggle dark mode" data-theme-toggle>
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"><path d="M20 14.5A8 8 0 0 1 9.5 4a8 8 0 1 0 10.5 10.5z"/></svg>
      </button>
    </nav>
    <button class="nav-toggle" type="button" aria-controls="nav" aria-expanded="false" data-nav-toggle>Menu</button>
  </div>
</header>
{% if is_home %}<div class="tri-band" aria-hidden="true"><i></i><i></i><i></i></div>{% endif %}
<main>
{% if persona and not is_home %}<div class="page-rule" aria-hidden="true"></div>{% endif %}
{{ content | safe }}
</main>
<footer class="site-footer">
  <div class="tri-band" aria-hidden="true" style="margin-bottom:0"><i></i><i></i><i></i></div>
  <div class="container">
    <div>© {{ site.year }} {{ site.name }} · Kathmandu, Nepal</div>
    <div class="links-row">
      {%- for l in site.links %}<a href="{{ l.url }}" rel="me noopener">{{ l.label }}</a>{% endfor %}
    </div>
  </div>
</footer>
<script src="/assets/js/site.js" defer></script>
</body>
</html>
