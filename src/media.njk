---
title: Media
description: Press coverage, interviews and podcasts featuring Bishesh Khanal.
---
<section class="page-hero container">
  <div class="eyebrow">Media</div>
  <h1>In the media</h1>
  <p class="lead">Interviews, features and podcasts — in English and Nepali.</p>
</section>
<section class="container">
  <div class="grid grid-3">
    {%- for m in media | visible | sortDesc("date") %}
    <{{ "a" if m.url else "div" }} class="card hoverable" {% if m.url %}href="{{ m.url }}" rel="noopener"{% endif %} data-persona="{{ m.persona }}" style="border-top:3px solid var(--accent)">
      <div class="meta" style="margin-bottom:.5rem">{{ m.outlet }} · {{ m.date | fuzzyDate }}{% if m.language == "ne" %} · नेपाली{% endif %}</div>
      <h3>{{ m.title }}</h3>
      <p><span class="badge">{{ m.kind }}</span></p>
    </{{ "a" if m.url else "div" }}>
    {%- endfor %}
  </div>
</section>
