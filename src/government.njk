---
title: Government
persona: dreamer
description: Policy and government engagement — Nepal's AI policy, national committees and public-sector AI.
---
<section class="page-hero container">
  <div class="eyebrow">{% set g = "dreamer" %}{% include "partials/glyph.njk" %}Dreamer · Government</div>
  <h1>Working with government</h1>
  <div class="lead">{{ government.lead | md | safe }}</div>
</section>
<section class="container section" style="padding-top:1rem">
  {%- for grp in government.engagements | groupBy("body") %}
  <div class="pub-year" data-persona="dreamer">
    <h2 style="font-family:var(--serif);font-size:1.05rem;line-height:1.35">{{ grp.key }}</h2>
    <ul class="rows" style="margin-bottom:1.5rem">
      {%- for e in grp.items %}<li class="row"><span class="d">{{ e.when }}</span><span><span class="t">{{ e.role }}</span>{% if e.text %}<br><span class="v">{{ e.text }}</span>{% endif %}</span></li>{% endfor %}
    </ul>
  </div>
  {%- endfor %}
</section>
