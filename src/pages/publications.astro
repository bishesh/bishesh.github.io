---
import Base from "../layouts/Base.astro";
import PageHero from "../components/PageHero.astro";
import { getPubs, themes, groupBy, formatAuthors, pubLink } from "../lib/site";
const pubs = await getPubs();
const byYear = groupBy(pubs, (p) => String(p.year));
const types = ["journal", "conference", "workshop", "preprint", "proceedings", "thesis"];
---
<Base title="Publications" persona="scientist" description="Peer-reviewed papers, preprints and proceedings by Bishesh Khanal, by year and theme.">
  <PageHero persona="scientist" eyebrow="Scientist · Publications" headline="Publications"
    lead={`${pubs.length} papers, preprints and proceedings, from biophysical brain models to AI for maternal health and the reorganization of work. The most current list is on [Google Scholar](https://scholar.google.com/citations?user=ZfaUCG5h3xsC).`} />
  <section class="container" data-filters="pubs">
    <p class="filter-label">Theme</p>
    <div class="chips">
      <button class="chip" data-key="themes" data-value="*" aria-pressed="true">All</button>
      {themes.map((t) => { const n = pubs.filter((p) => p.themes.includes(t.key)).length; return n > 0 && (
        <button class="chip" data-key="themes" data-value={t.key} aria-pressed="false" title={t.blurb}>{t.label} <span class="n">{n}</span></button>); })}
    </div>
    <p class="filter-label">Type</p>
    <div class="chips">
      <button class="chip" data-key="type" data-value="*" aria-pressed="true">All</button>
      {types.map((ty) => <button class="chip" data-key="type" data-value={ty} aria-pressed="false">{ty[0].toUpperCase() + ty.slice(1)} <span class="n">{pubs.filter((p) => p.type === ty).length}</span></button>)}
    </div>
    <p class="meta">Showing <span data-filter-count="pubs">{pubs.length}</span> · <strong>bold</strong> = Bishesh Khanal</p>
  </section>
  <section class="container section" style="padding-top:1.5rem">
    {byYear.map(([year, items]) => (
      <div class="pub-year" data-filter-group="pubs">
        <h2>{year}</h2>
        <ol class="pub-list">
          {items.map((p) => { const href = pubLink(p); return (
            <li class="pub" data-filterable="pubs" data-themes={p.themes.join(" ")} data-type={p.type}>
              <div class="title">{href ? <a href={href}>{p.title}</a> : p.title}</div>
              <div class="authors" set:html={formatAuthors(p.authors)} />
              <div class="venue">{p.venue}</div>
              <div class="plinks"><span class="badge type">{p.type}</span>
                {p.doi && <a href={`https://doi.org/${p.doi}`}>DOI</a>}
                {p.arxiv && <a href={`https://arxiv.org/abs/${p.arxiv}`}>arXiv</a>}
                {p.pdf && <a href={p.pdf}>PDF</a>}
                {p.code && <a href={p.code}>Code</a>}
              </div>
            </li>); })}
        </ol>
      </div>
    ))}
  </section>
</Base>
