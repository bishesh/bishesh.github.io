---
import Base from "../layouts/Base.astro";
import AppearanceCard from "../components/AppearanceCard.astro";
import { getAppearances, FORMATS, KIND_LABEL } from "../lib/site";

// Talks & media: every talk, panel, podcast, video interview and article on one page, sliced along independent
// dimensions. Format is the tab (one at a time); kind or role refines it (shown under the tab it belongs to);
// persona cuts across all of them; reach (scope) is both a chip row and the section, and each section collapses.
// Within a section: newest first. Filtering is site.js's chip filter.
const all = await getAppearances();
const sorted = (xs: typeof all) => [...xs].sort((a, b) => String(b.date).localeCompare(String(a.date)));
const tiers = [
  { key: "international", label: "International", note: "Talks abroad, global venues and audiences, ANAIS and HAICon", style: "grid" },
  { key: "national", label: "National", note: "Government, conferences, institutions and media in Nepal", style: "compact" },
];
const count = (f: (x: (typeof all)[number]) => boolean) => all.filter(f).length;
const formats = FORMATS.map((f) => ({ ...f, n: count((x) => x.format === f.key) })).filter((f) => f.n);
// the second row under each tab: kinds within that format, or (podcasts) his role
const refine = formats.map((f) => ({
  format: f.key,
  key: f.key === "podcasts" ? "role" : "kind",
  values: f.key === "podcasts"
    ? [{ v: "host", label: "Bishesh hosts" }, { v: "guest", label: "Bishesh as guest" }]
    : f.kinds.map((k) => ({ v: k, label: KIND_LABEL[k] })),
})).map((r) => ({
  ...r,
  values: r.values.map((x) => ({ ...x, n: count((m) => m.format === r.format && (r.key === "role" ? m.role : m.kind) === x.v) })).filter((x) => x.n),
})).filter((r) => r.values.length > 1);
const personas = ["dreamer", "scientist", "entrepreneur"];
---
<Base title="Talks & media" description="Keynotes, talks, panels, podcasts, interviews and press coverage of Bishesh Khanal — international first.">
  <h1 class="visually-hidden">Talks & media</h1>
  <section class="container talks-bar" data-filters="talks">
    <div class="tabs" role="group" aria-label="Type">
      <button class="tab" data-key="format" data-value="*" data-single aria-pressed="true">All <span class="n">{all.length}</span></button>
      {formats.map((f) => <button class="tab" data-key="format" data-value={f.key} data-single aria-pressed="false">{f.label} <span class="n">{f.n}</span></button>)}
    </div>
    {refine.map((r) => (
      <div class="chips" data-for-key="format" data-for={r.format} hidden>
        <button class="chip" data-key={r.key} data-value="*" aria-pressed="true">All</button>
        {r.values.map((x) => <button class="chip" data-key={r.key} data-value={x.v} aria-pressed="false">{x.label} <span class="n">{x.n}</span></button>)}
      </div>
    ))}
    <div class="chip-rows">
    <div class="chips">
      <button class="chip" data-key="personaF" data-value="*" aria-pressed="true">All personas</button>
      {personas.map((p) => <button class="chip" data-key="personaF" data-value={p} data-persona={p} data-live aria-pressed="false"><i class={`dot ${p}`} />{p[0].toUpperCase() + p.slice(1)} <span class="n">{count((x) => x.persona === p)}</span></button>)}
    </div>
    <div class="chips">
      <button class="chip" data-key="scope" data-value="*" aria-pressed="true">All reach</button>
      {tiers.map((t) => <button class="chip" data-key="scope" data-value={t.key} data-live aria-pressed="false">{t.label} <span class="n">{count((x) => x.scope === t.key)}</span></button>)}
    </div>
    </div>
  </section>
  <div class="container">
    {tiers.map((tier) => { const items = sorted(all.filter((t) => t.scope === tier.key)); return items.length > 0 && (
      <details class="tier" open data-filter-group="talks">
        <summary class="tier-head">
          <h2>{tier.label} <span class="n" data-group-count>{items.length}</span></h2><span class="meta">{tier.note}</span>
          <svg class="chev" width="14" height="14" viewBox="0 0 14 14" aria-hidden="true"><path d="M3 5l4 4 4-4" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" /></svg>
        </summary>
        <div class={`talk-grid${tier.style === "compact" ? " compact" : ""}`}>{items.map((m) => <AppearanceCard m={m} />)}</div>
      </details>); })}
  </div>
</Base>
